#!/bin/sh
# Chặn commit nếu có key / file bí mật. Kích hoạt:  git config core.hooksPath .githooks

# 1. Chặn file bí mật theo tên, kể cả khi bị `git add -f`
blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env(\..*)?$|\.(pem|key|p12|pfx|crt|sql|dump)$|(^|/)(credentials|service-account|client_secret)[^/]*\.json$|(^|/)\.?mcp\.json$|(^|/)\.kiro/' | grep -vE '(^|/)\.env\.example$|^drizzle/[^/]+\.sql$')
if [ -n "$blocked" ]; then
  echo "✋ Commit bị chặn — các file sau có thể chứa bí mật:"
  echo "$blocked" | sed 's/^/   - /'
  echo "   Bỏ khỏi commit:  git restore --staged <file>"
  exit 1
fi

# 2. Quét nội dung đang staged bằng gitleaks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "✋ Chưa cài gitleaks — không thể kiểm tra bí mật. Cài:  brew install gitleaks"
  exit 1
fi

if ! gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml; then
  echo "✋ Commit bị chặn — gitleaks phát hiện bí mật trong nội dung ở trên."
  echo "   Xoá bí mật khỏi file, đưa vào .env (đã bị .gitignore chặn), rồi commit lại."
  exit 1
fi
