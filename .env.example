# ManagementTask — cấu hình
# Copy file này thành .env rồi điền giá trị:  cp .env.example .env
# KHÔNG commit file .env, KHÔNG chia sẻ nội dung của nó.

# ===== Bắt buộc =====

# Địa chỉ người dùng mở app (dùng cho link và Google OAuth redirect)
APP_URL=http://localhost:3000

# Chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng:  openssl rand -base64 32
AUTH_SECRET=

# Mật khẩu database (chỉ dùng chữ và số). Tạo bằng:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Google OAuth client của riêng bạn — hướng dẫn: docs/08-dong-goi-docker.md mục 8.10
# Redirect URI cần khai báo:  <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Nên có =====

# Token bot Telegram (tạo qua @BotFather). Để trống = không gửi nhắc việc tới Telegram
TELEGRAM_BOT_TOKEN=

# ===== Tuỳ chọn =====

# Ghim phiên bản image, ví dụ 1.2.3
APP_VERSION=latest

# Cổng trên máy để mở app
APP_PORT=3000

# Múi giờ mặc định cho người dùng mới
TZ=Asia/Ho_Chi_Minh

# Giới hạn ai được đăng nhập (để trống = mọi tài khoản Google)
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# Tên miền — chỉ cần khi chạy: docker compose --profile https up -d
DOMAIN=
